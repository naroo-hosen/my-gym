generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Member {
  id           Int         @id @default(autoincrement())
  name         String
  phone        String
  birthDate    DateTime?
  gender       String?
  parentPhone  String?
  memo         String?
  status       String      @default("ACTIVE")
  membershipId Int?
  membership   Membership? @relation(fields: [membershipId], references: [id])
  createdAt    DateTime    @default(now())
}

model Membership {
  id               Int      @id @default(autoincrement())
  duration         Int
  weeklyAttendance Int
  price            Int
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  members          Member[]
}
