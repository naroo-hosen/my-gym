generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Member {
  id                Int                @id @default(autoincrement())
  name              String
  phone             String
  birthDate         DateTime?
  gender            String?
  parentPhone       String?
  memo              String?
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now())
  memberMemberships MemberMembership[]
  activities        MemberActivity[]
  equipmentSales    EquipmentSale[]
}

model Membership {
  id               Int      @id @default(autoincrement())
  duration         Int
  durationUnit     String   @default("MONTH")
  weeklyAttendance Int
  price            Int
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  memberMemberships MemberMembership[]
}

model MemberMembership {
  id           Int        @id @default(autoincrement())
  memberId     Int
  membershipId Int
  assignedAt   DateTime   @default(now())
  expiresAt    DateTime?
  pausedAt     DateTime?
  pauseEndsAt  DateTime?
  totalPausedMs Int       @default(0)
  member       Member     @relation(fields: [memberId], references: [id])
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@unique([memberId])
}

model MemberActivity {
  id          Int      @id @default(autoincrement())
  memberId    Int
  type        String
  description String
  metadata    String?
  createdAt   DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
}

model SalesEntry {
  id          Int      @id @default(autoincrement())
  type        String
  date        DateTime
  amount      Int
  title       String
  description String
  createdAt   DateTime @default(now())

  @@index([date, type])
}

model Equipment {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  sales     EquipmentSale[]
}

model EquipmentSale {
  id          Int       @id @default(autoincrement())
  memberId    Int
  equipmentId Int
  price       Int
  paymentMethod String
  soldAt      DateTime  @default(now())
  member      Member    @relation(fields: [memberId], references: [id])
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@index([memberId, soldAt])
  @@index([equipmentId, soldAt])
}
