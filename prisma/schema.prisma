generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Member {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  birthDate   DateTime?
  gender      String?
  parentPhone String?
  memo        String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
}
